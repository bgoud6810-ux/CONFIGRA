# Copy this file to .env and set your own values. Never commit .env.
# API key required by CONFIGRA for scan dispatch/cancellation when set.
CONFIGRA_API_KEY=your-api-key-here

# Optional shared password (HTTP Basic auth) for the whole web UI.
# Set this before exposing CONFIGRA through a public tunnel.
# Username can be anything; only the password is checked.
CONFIGRA_ACCESS_PASSWORD=choose-a-strong-password

# Optional bind settings (defaults: 127.0.0.1:5000)
# HOST=0.0.0.0
# PORT=5000
